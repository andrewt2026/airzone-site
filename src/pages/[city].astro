const offsets = city.faqGroups.map((_: any, i: number) =>
  city.faqGroups.slice(0, i).reduce((n: number, g: any) => n + g.items.length, 0));
const strip = (h: string) => h.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: city.faqGroups.flatMap((g: any) => g.items.map((it: any) => ({
    '@type': 'Question', name: strip(it.q), acceptedAnswer: { '@type': 'Answer', text: strip(it.a) } }))),
};
