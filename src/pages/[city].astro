// City / service-area page template. One JSON file per city in src/data/cities/.
// To add a city: copy an existing JSON file, rename it to the new slug, rewrite the copy.
import BaseLayout from '../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const files = import.meta.glob('../data/cities/*.json', { eager: true });
  return Object.values(files).map((mod: any) => ({ params: { city: mod.default.slug }, props: { city: mod.default } }));
}
