---
import BaseLayout from '../layouts/BaseLayout.astro';
const seo = { title: 'Page Not Found | Air Zone Experts', robots: 'noindex, follow' };
---
<BaseLayout seo={seo} bodyClass="error404 et_divi_theme et_pb_button_helper_class et_fullwidth_nav et_fixed_nav et_show_nav et_primary_nav_dropdown_animation_fade et_secondary_nav_dropdown_animation_fade et_header_style_left et_pb_footer_columns4 et_cover_background et_pb_gutter et_pb_gutters3 et_no_sidebar et_divi_theme et-db">
  <div class="container" style="padding:120px 0;text-align:center">
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist. <a href="/">Go to the homepage</a> or call <a href="tel:2144309059">(214) 430-9059</a>.</p>
  </div>
</BaseLayout>
