---
// Site footer (Divi Theme Builder footer). The contact form lives in FooterForm.astro.
import FooterForm from './FooterForm.astro';
const path = Astro.url.pathname;
const same = (h: string | null) => !!h && (h === path || h === path.replace(/\/$/, ''));
const menuClass = (base: string, href: string | null, kids: string[] = []) =>
  same(href) ? `${base} current-menu-item current_page_item`
  : kids.some(same) ? `${base} current-menu-ancestor current-menu-parent` : base;

